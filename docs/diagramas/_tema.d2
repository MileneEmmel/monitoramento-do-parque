# Tema compartilhado. Os arquivos numerados podem ser abertos diretamente no VS Code.
vars: {
  d2-config: {
    layout-engine: tala
    theme-id: 0
    pad: 32
    theme-overrides: {
      N1: "#173A2B"
      N2: "#35664A"
      N3: "#82AA8B"
      N4: "#C9DECC"
      N5: "#EAF3E8"
      N6: "#F6FAF5"
      N7: "#FFFFFF"
      B1: "#1E5A3B"
      B2: "#438256"
      B3: "#81AE76"
      B4: "#BFD8B5"
      B5: "#DFEDD9"
      B6: "#EFF6EA"
      AA2: "#2E6044"
    }
  }
}
classes: {
  bloco: {
    style: {
      fill: "#EFF6EA"
      stroke: "#438256"
      font-color: "#173A2B"
      font-size: 20
      border-radius: 10
      stroke-width: 2
    }
  }
  destaque: {
    style: {
      fill: "#1E5A3B"
      stroke: "#1E5A3B"
      font-color: "#FFFFFF"
      font-size: 20
      border-radius: 10
      stroke-width: 2
    }
  }
  grupo: {
    style: {
      fill: "#F6FAF5"
      stroke: "#82AA8B"
      font-color: "#173A2B"
      font-size: 22
      border-radius: 12
      stroke-width: 1
    }
  }
  caso: {
    shape: oval
    style: {
      fill: "#EFF6EA"
      stroke: "#438256"
      font-color: "#173A2B"
      font-size: 19
      stroke-width: 2
    }
  }
  ator: {
    shape: person
    width: 90
    height: 100
    label.near: outside-bottom-center
    style: {
      fill: "#DFEDD9"
      stroke: "#1E5A3B"
      font-color: "#173A2B"
      font-size: 21
      stroke-width: 2
    }
  }
  estado: {
    style: {
      fill: "#EFF6EA"
      stroke: "#438256"
      font-color: "#173A2B"
      font-size: 19
      border-radius: 18
      stroke-width: 2
    }
  }
  classe: {
    shape: class
    style: {
      fill: "#1E5A3B"
      stroke: "#EFF6EA"
      font-color: "#FFFFFF"
      font-size: 18
      stroke-width: 2
    }
  }
}

titulo: Diagrama {
  shape: text
  near: top-center
  style: {
    font-size: 28
    bold: true
    font-color: "#173A2B"
  }
}
