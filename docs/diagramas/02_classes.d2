  "#detect_result_cb(result)": void
}
Counter: "park::Counter" {
  class: classe
  left: 680
  top: 180
  width: 520
  "+config": Config
  "+entries": uint64_t
  "+exits": uint64_t
  "-tracks[32]": Track
  "+update(...)": void
  "+state(id, now)": int
  "+clear_tracks()": void
}
Config: "park::Config" {
  class: classe
  left: 1420
  top: 0
  width: 350
  "+first, second": float
  "+horizontal, reverse": bool
}
Track: "park::Track" {
  class: classe
  left: 1420
  top: 380
  width: 350
  "+id, hits": unsigned
  "+x, y, vx, vy": float
  "+origin, zone": int
  "+seen, counted_at": int64_t
}
Observation: "park::Observation" {
  class: classe
  left: 680
  top: 650
  width: 350
  "+x, y": float
  "+width, height": float
}
PowerPolicy: "park::PowerPolicy" {
  class: classe
  left: 2010
  top: 0
  width: 520
  "+activity, frame": uint64_t
  "+camera, validated": bool
  "+pir(level, now_ms)": void
  "+detection(people, now_ms)": void
  "+idle_block(now, grace, quiet)": const_char_ptr
}
CloudSchedule: "park::CloudSchedule" {
  class: classe
  left: 2010
  top: 490
  width: 520
  "+collect_at, retry_at": uint64_t
  "+failures": unsigned
  "+permanent": bool
  "+pending(now_ms)": void
  "+due(now_ms, closing)": bool
  "+success()": void
  "+failure(now, closing, retryable)": void
}

