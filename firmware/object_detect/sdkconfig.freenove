# Freenove ESP32-S3-WROOM N8R8, USB-UART CH343.
CONFIG_APP_BOARD_FREENOVE_S3=y
CONFIG_APP_PIR_SLEEP=y
CONFIG_APP_PIR_IDLE_SECONDS=30
CONFIG_APP_PIR_SYNC_SECONDS=300
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MEMTEST=y
# TLS buffers must use PSRAM: camera/AI reserve the internal DMA-capable heap.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Keep AES acceleration/encryption, but avoid a fatal late ISR allocation when
# camera DMA, Wi-Fi and AI are active. The IDF driver polls completion instead.
# CONFIG_MBEDTLS_AES_USE_INTERRUPT is not set
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_PEDESTRIAN_DETECT_MODEL_IN_FLASH_RODATA=y
CONFIG_CAMERA_OV3660=y
CONFIG_CAMERA_OV3660_DVP_RGB565_BE_240X240_24FPS=y
CONFIG_CAMERA_OV3660_DVP_DEFAULT_FMT_RGB565_BE_240X240_24FPS=y
CONFIG_CAMERA_GC0308=y
CONFIG_CAMERA_GC0308_DVP_RGB565_BE_320X240_20FPS=y
CONFIG_CAMERA_GC0308_DVP_DEFAULT_FMT_RGB565_BE_320X240_20FPS=y
